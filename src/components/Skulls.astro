---
// Strength marks, as on the printed menu (one skull per X).
const { n = 1 } = Astro.props as { n: number };
---
<span class="skulls" role="img" aria-label={`Strength ${n} of 6`}>
  {Array.from({ length: n }).map(() => (
    <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 1.5c-3.3 0-5.5 2.3-5.5 5.2 0 1.8.9 3.1 2 3.8V13c0 .8.6 1.5 1.4 1.5h4.2c.8 0 1.4-.7 1.4-1.5v-2.5c1.1-.7 2-2 2-3.8 0-2.9-2.2-5.2-5.5-5.2z" fill="currentColor"/><circle cx="5.8" cy="7.2" r="1.4" fill="var(--skull-eye, #fff0d4)"/><circle cx="10.2" cy="7.2" r="1.4" fill="var(--skull-eye, #fff0d4)"/><path d="M7 12.2v2M9 12.2v2" stroke="var(--skull-eye, #fff0d4)" stroke-width="1"/></svg>
  ))}
</span>
